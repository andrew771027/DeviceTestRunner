{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: main.py sample config",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "--config",
                "./configs/sample.yaml"
            ]
        },
        {
            "name": "Python Debugger: Test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "args": [
                "tests/test_unit/test_runner.py",
                "-k",
                "test_cancelled_step_is_not_retried"

            ]
        }
    ]
}
